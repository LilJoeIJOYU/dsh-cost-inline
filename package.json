{
  "name": "dsh-cost-inline",
  "version": "1.0.0",
  "description": "在已有的 token 用量面板内联显示本会话预估花费与 DeepSeek 账户余额,不额外占用界面位置 | Inline session cost + DeepSeek balance inside the existing token-usage panel, peak/off-peak aware",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "cost",
    "balance"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LilJoeIJOYU/dsh-cost-inline.git"
  },
  "homepage": "https://github.com/LilJoeIJOYU/dsh-cost-inline#readme",
  "bugs": {
    "url": "https://github.com/LilJoeIJOYU/dsh-cost-inline/issues"
  }
}
